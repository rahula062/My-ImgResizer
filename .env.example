# Application Configuration
VITE_APP_NAME=PixelCraft
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=production

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_WEB_WORKERS=true

# PDF.js Worker URL
VITE_PDFJS_WORKER_URL=https://unpkg.com/pdfjs-dist@3.11.174/build/pdf.worker.min.js

# Performance
VITE_MAX_FILE_SIZE=10485760
VITE_MAX_IMAGE_DIMENSION=10000

# Build Configuration
VITE_BUILD_TARGET=esnext
VITE_BUILD_SOURCEMAP=false